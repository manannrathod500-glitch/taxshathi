# TaxSathi backend environment
# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Existing settings ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=taxsathi
GEMINI_API_KEY=
ADMIN_API_KEY=

# --- Tax assistant chat (OpenRouter) ---
# Option A (preferred): all free-tier keys, comma separated.
OPENROUTER_KEYS=sk-or-v1-xxxxxxxx,sk-or-v1-xxxxxxxx,sk-or-v1-xxxxxxxx
# Option B: one per variable (any number).
# OPENROUTER_KEY_1=sk-or-v1-xxxxxxxx
# OPENROUTER_KEY_2=sk-or-v1-xxxxxxxx
# Optional: override the primary model (defaults to Nemotron 3 Super 120B free).
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
